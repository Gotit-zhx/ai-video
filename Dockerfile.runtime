FROM eclipse-temurin:21-jre
WORKDIR /app
RUN useradd --system --uid 10001 spring \
    && mkdir -p /data/automation-skills /data/automation-attachments \
    && chown -R spring:spring /data/automation-skills /data/automation-attachments
COPY target/*.jar app.jar
USER spring
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
