[Unit]
Description=Isolated BOSS recruiter virtual display
After=network.target

[Service]
Type=simple
User=heyi-boss
Group=heyi-boss
WorkingDirectory=/opt/heyi/boss-agent
Environment=HOME=/opt/heyi/boss-agent
UMask=0077
ExecStart=/opt/heyi/boss-agent/bin/start-display.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
