MYSQL_DATABASE=ai_commerce
MYSQL_USER=ai_commerce
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_PASSWORD=change-me
APP_ADMIN_PHONE=13800000000
APP_ADMIN_PASSWORD=change-me
APP_TENANT_CODE=heyi
APP_TENANT_NAME=赫逸智能化
APP_MODEL_SECRET_KEY=replace-with-at-least-32-random-characters
APP_SHOP_CREDENTIAL_KEY=replace-with-a-separate-32-character-random-key
APP_SESSION_COOKIE_SECURE=true
APP_SHOP_AUTH_CALLBACK_BASE_URL=https://api.example.com
APP_SHOP_AUTH_FRONTEND_BASE_URL=https://app.example.com
APP_SHOPEE_ENABLED=false
APP_SHOPEE_PARTNER_ID=
APP_SHOPEE_PARTNER_KEY=
# Production defaults. For Sandbox v2, replace BOTH hosts with:
# APP_SHOPEE_AUTH_BASE_URL=https://open.sandbox.test-stable.shopee.com
# APP_SHOPEE_API_BASE_URL=https://openplatform.sandbox.test-stable.shopee.sg
# Mainland China Sandbox v2 API alternative: https://openplatform.sandbox.test-stable.shopee.cn
# Use the application's Test Partner ID/Key for Sandbox v2.
APP_SHOPEE_AUTH_BASE_URL=https://open.shopee.com
APP_SHOPEE_API_BASE_URL=https://partner.shopeemobile.com
APP_SHOPEE_IMAGE_UPLOAD_SIGN_SCOPE=SHOP
APP_TIKTOK_SHOP_ENABLED=false
APP_TIKTOK_SHOP_SERVICE_ID=
APP_TIKTOK_SHOP_APP_KEY=
APP_TIKTOK_SHOP_APP_SECRET=
APP_TIKTOK_SHOP_AUTHORIZATION_BASE_URL=https://services.tiktokshop.com
APP_TIKTOK_SHOP_TOKEN_BASE_URL=https://auth.tiktok-shops.com
APP_TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
# Shopee + TikTok Shop: use OFFICIAL to route by destination; a specific provider code restricts publishing to that platform.
APP_PRODUCT_PUBLISHING_PROVIDER=DRY_RUN
APP_SHOP_LIVE_PUBLISHING_ENABLED=false
APP_AUTOMATION_AGENT_TOKEN=replace-with-a-long-random-agent-token
APP_PI_RUNTIME_TOKEN=replace-with-a-long-random-runtime-token
APP_DISPATCH_ENABLED=true
APP_DISPATCH_WORKER_ID=heyi-app-worker
APP_DISPATCH_WORKER_THREADS=8
APP_MAX_ACTIVE_TASKS=80
APP_MAX_MODEL_CALLS=20
# Durable private material links; raw OSS previews still use short-lived STS URLs.
APP_VIDEO_REFERENCE_LINK_TTL=72h
# Optional read-only signer: mount a private properties file into this container path.
# Never put real AccessKeys in the repository or chat.
APP_OSS_SIGNING_CREDENTIALS_FILE=
APP_OSS_DIRECT_LINK_TTL=72h
# Opt in only when image files are intentionally public and OSS public access is allowed.
APP_OSS_PUBLIC_IMAGES=false
FRONTEND_PORT=3000
APP_PORT=8080

# Product watermark detection and preservation review (separate from the chat model).
APP_PRODUCT_WATERMARK_MODEL_ID=grok-4.6
APP_PRODUCT_WATERMARK_PROVIDER=DRY_RUN
# Enable for sandbox-only integration tests before permitting Shopee writes.
APP_SHOPEE_SANDBOX_ONLY=false
