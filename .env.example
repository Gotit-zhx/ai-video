MYSQL_DATABASE=ai_commerce
MYSQL_USER=ai_commerce
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
REDIS_PASSWORD=change-me
APP_ADMIN_PHONE=13800000000
APP_ADMIN_PASSWORD=change-me
APP_TENANT_CODE=heyi
APP_TENANT_NAME=赫逸智能化
APP_MODEL_SECRET_KEY=replace-with-at-least-32-random-characters
APP_AUTOMATION_AGENT_TOKEN=replace-with-a-long-random-agent-token
APP_PI_RUNTIME_TOKEN=replace-with-a-long-random-runtime-token
APP_DISPATCH_ENABLED=true
APP_DISPATCH_WORKER_ID=heyi-app-worker
APP_DISPATCH_WORKER_THREADS=8
APP_MAX_ACTIVE_TASKS=80
APP_MAX_MODEL_CALLS=20
# Durable private material links; raw OSS previews still use short-lived STS URLs.
APP_VIDEO_REFERENCE_LINK_TTL=72h
# Optional read-only signer: mount a private properties file into this container path.
# Never put real AccessKeys in the repository or chat.
APP_OSS_SIGNING_CREDENTIALS_FILE=
APP_OSS_DIRECT_LINK_TTL=72h
# Opt in only when image files are intentionally public and OSS public access is allowed.
APP_OSS_PUBLIC_IMAGES=false
FRONTEND_PORT=3000
APP_PORT=8080
