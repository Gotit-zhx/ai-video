[Unit]
Description=Backup Heyi MySQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/heyi-mysql-backup
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=null
StandardError=null
TimeoutStartSec=3900
