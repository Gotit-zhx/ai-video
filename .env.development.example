# Copy to .env.development only when not using `python3 scripts/dev.py init`.
# Replace every placeholder with a different locally generated secret, except
# DB_PASSWORD which must equal MYSQL_PASSWORD.
DEV_MYSQL_PORT=3307
DEV_REDIS_PORT=6380
MYSQL_DATABASE=ai_commerce_dev
MYSQL_USER=devuser
MYSQL_PASSWORD=replace-with-the-same-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-mysql-root-password
REDIS_PASSWORD=replace-with-a-redis-password

DB_URL=jdbc:mysql://127.0.0.1:3307/ai_commerce_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=devuser
DB_PASSWORD=replace-with-the-same-mysql-password
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

APP_PORT=8080
APP_PUBLIC_BASE_URL=http://localhost:8080
APP_SHOP_AUTH_FRONTEND_BASE_URL=http://localhost:8080
APP_SESSION_COOKIE_SECURE=false
APP_ALLOW_INSECURE_PUBLIC_HTTP=true
APP_DISPATCH_ENABLED=false
APP_ADMIN_PASSWORD=replace-with-a-local-admin-password
APP_MODEL_SECRET_KEY=replace-with-a-local-model-encryption-key
APP_SHOP_CREDENTIAL_KEY=replace-with-a-local-shop-encryption-key
APP_AUTOMATION_AGENT_TOKEN=replace-with-a-local-automation-token
APP_PI_RUNTIME_TOKEN=replace-with-a-local-pi-runtime-token
APP_VIDEO_REFERENCE_LINK_SECRET=replace-with-a-local-video-link-secret
