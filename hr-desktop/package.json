{
  "name": "heyi-recruiter",
  "version": "0.1.10",
  "private": true,
  "description": "赫逸招聘助手 — 桌面悬浮球与独立 BOSS 浏览器",
  "author": "赫逸智能化",
  "license": "UNLICENSED",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --self-test",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.hoyee.recruiter",
    "productName": "赫逸招聘助手",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "package.json",
      "assets/icon.png",
      "vendor/*LICENSE*"
    ],
    "extraResources": [
      {
        "from": "runtime/dist/heyi-boss",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Heyi-Recruiter-${version}-mac-${arch}.${ext}",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Heyi-Recruiter-${version}-windows-${arch}-Setup.${ext}",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    }
  }
}
